              "value": "={{ $json.relevance }}"
            },
            {
              "name": "thumbnail_url",
              "value": "={{ $json.thumbnail_url }}"
            },
            {
              "name": "category",
              "value": "={{ $json.category }}"
            },
            {
              "name": "abstract",
              "value": "={{ $('Get PDF URL').item.json.summary }}"
            },
            {
              "name": "what_it_does",
              "value": "={{ $json.parsed.what_it_does }}"
            },
            {
              "name": "how_it_works",
              "value": "={{ $json.parsed.how_it_works }}"
            },
            {
              "name": "why_it_matters",
              "value": "={{ $json.parsed.why_it_matters }}"
            },
            {
              "name": "used_fallback",
              "value": "={{ $json.used_fallback === true ? 'true' : 'false' }}"
            },
            {
              "name": "thumbnail_filename",
              "value": "={{ $json.thumbnail_filename || '' }}"
            }
          ]
        }
      },
      "id": "qdrant-store-id",
      "name": "Qdrant Store",
      "type": "n8n-nodes-base.qdrantVectorStore",
      "typeVersion": 1,
      "position": [
        2050,
        420
      ],
      "credentials": {
        "qdrantApi": {
          "id": "qdrant-cred-id"
        }
      }
