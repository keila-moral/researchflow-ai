    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.message?.content || $json.text || '';\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  throw new Error(`OpenAI Summarize returned non-JSON: ${raw.slice(0, 200)}`);\n}\n\nconst tags = Array.isArray(parsed.tags) ? parsed.tags : [];\n\n// Prepend fallback warning to telegram_summary when PDF was unavailable\nif ($json.used_fallback && parsed.telegram_summary) {\n  parsed.telegram_summary =\n    '⚠️ _PDF unavailable — summary generated from abstract only_\\n\\n' +\n    parsed.telegram_summary;\n}\n\nreturn {\n  json: {\n    ...$json,\n    parsed,\n    tags,\n    tags_string: tags.join(', '),\n    relevance: parsed.relevance || 'Unknown',\n  }\n};\n"
      },
      "id": "extract-tags-id",
      "name": "Extract Tags",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1900,
        420
      ]
