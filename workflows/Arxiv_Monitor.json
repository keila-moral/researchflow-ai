      "id": "arxiv-fetch-id",
      "name": "Fetch Arxiv",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        700,
        180
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $input.item.json.body || $input.item.json;\nconst feed = data.feed;\nconst entries = feed?.entry || [];\nconst entryList = Array.isArray(entries) ? entries : (entries ? [entries] : []);\n\nreturn entryList.map(entry => {\n  const title = typeof entry.title === 'string' ? entry.title.replace(/\\n/g, ' ') : (entry.title?.['#text'] || '').replace(/\\n/g, ' ');\n  const summary = typeof entry.summary === 'string' ? entry.summary.replace(/\\n/g, ' ') : (entry.summary?.['#text'] || '').replace(/\\n/g, ' ');\n  return {\n    json: {\n      id: entry.id,\n      title: title.trim(),\n      summary: summary.trim(),\n      published: entry.published,\n      link: Array.isArray(entry.link) ? entry.link[0]?.['@_href'] : entry.link?.['@_href'] || entry.link || entry.id\n    }\n  };\n});"
      },
      "id": "code-process-id",
      "name": "Process Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        850,
        180
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const allPapers = [];\nlet runIndex = 0;\nwhile (true) {\n  try {\n    const items = $('Process Results').all(0, runIndex);\n    if (!items || items.length === 0) {\n      break;\n    }\n    allPapers.push(...items);\n    runIndex++;\n  } catch (error) {\n    break;\n  }\n}\nreturn allPapers;"
      },
      "id": "merge-papers-id",
      "name": "Merge Papers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        550,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const paperId = item.json.id;\n  try {\n    const response = await fetch('http://qdrant:6333/collections/arxiv_papers/points/scroll', {\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application/json',\n        'api-key': $vars.QDRANT_API_KEY || ''\n      },\n      body: JSON.stringify({\n        filter: {\n          must: [\n            {\n              key: 'metadata.url',\n              match: { value: paperId }\n            }\n          ]\n        },\n        limit: 1\n      })\n    });\n\n    if (response.ok) {\n      const data = await response.json();\n      const points = data.result?.points || [];\n      item.json.already_processed = points.length > 0;\n    } else {\n      item.json.already_processed = false;\n    }\n  } catch (error) {\n    item.json.already_processed = false;\n  }\n}\nreturn $input.all();\n"
      },
      "id": "qdrant-check-exists-id",
      "name": "Check If Exists",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        420
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "filter-condition-id",
              "leftValue": "={{ $json.already_processed }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-processed-id",
      "name": "Filter Processed",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        850,
        420
      ]
    },
