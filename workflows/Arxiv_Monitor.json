                    }
                ]
            ]
        },
        "Check If Exists": {
            "main": [
                [
                    {
                        "node": "Filter Processed",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Filter Processed": {
            "main": [
                [
                    {
                        "node": "OpenAI Summarize",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "OpenAI Summarize": {
            "main": [
                [
                    {
                        "node": "Qdrant Store",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "active": false,
    "settings": {
        "executionOrder": "v1",
        "errorWorkflow": "error-handler-workflow-id"
    }
}