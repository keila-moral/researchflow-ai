{
  "name": "Arxiv Monitor & Process",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "trigger-id",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return [\n  { json: { category: \"cs.AI\" } },\n  { json: { category: \"cs.LG\" } },\n  { json: { category: \"cs.CV\" } },\n  { json: { category: \"cs.CL\" } },\n  { json: { category: \"cs.RO\" } },\n  { json: { category: \"stat.ML\" } }\n];"
      },
      "id": "define-categories-id",
      "name": "Define Categories",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "loop-categories-id",
      "name": "Loop Categories",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "id": "wait-id",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        550,
        180
      ]
    },
    {
      "parameters": {
        "url": "https://export.arxiv.org/api/query",
        "options": {},
        "queryParametersUi": {
          "parameter": [
            {
              "name": "search_query",
              "value": "=cat:{{ $json.category }}"
            },
            {
              "name": "sortBy",
              "value": "submittedDate"
            },
            {
              "name": "sortOrder",
              "value": "descending"
            },
            {
              "name": "max_results",
              "value": "10"
            }
          ]
        }
      },
      "id": "arxiv-fetch-id",
      "name": "Fetch Arxiv",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        700,
        180
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $input.item.json.body || $input.item.json;\nconst feed = data.feed;\nconst entries = feed?.entry || [];\nconst entryList = Array.isArray(entries) ? entries : (entries ? [entries] : []);\n\nreturn entryList.map(entry => {\n  const title = typeof entry.title === 'string' ? entry.title.replace(/\\n/g, ' ') : (entry.title?.['#text'] || '').replace(/\\n/g, ' ');\n  const summary = typeof entry.summary === 'string' ? entry.summary.replace(/\\n/g, ' ') : (entry.summary?.['#text'] || '').replace(/\\n/g, ' ');\n  return {\n    json: {\n      id: entry.id,\n      title: title.trim(),\n      summary: summary.trim(),\n      published: entry.published,\n      link: Array.isArray(entry.link) ? entry.link[0]?.['@_href'] : entry.link?.['@_href'] || entry.link || entry.id\n    }\n  };\n});"
      },
      "id": "code-process-id",
      "name": "Process Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        850,
        180
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const allPapers = [];\nlet runIndex = 0;\nwhile (true) {\n  try {\n    const items = $('Process Results').all(0, runIndex);\n    if (!items || items.length === 0) {\n      break;\n    }\n    allPapers.push(...items);\n    runIndex++;\n  } catch (error) {\n    break;\n  }\n}\nreturn allPapers;"
      },
      "id": "merge-papers-id",
      "name": "Merge Papers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        550,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const paperId = item.json.id;\n  try {\n    const response = await fetch('http://qdrant:6333/collections/arxiv_papers/points/scroll', {\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application/json'\n      },\n      body: JSON.stringify({\n        filter: {\n          should: [\n            {\n              key: \"metadata.url\",\n              match: {\n                value: paperId\n              }\n            },\n            {\n              key: \"url\",\n              match: {\n                value: paperId\n              }\n            }\n          ]\n        },\n        limit: 1\n      })\n    });\n    \n    if (response.ok) {\n      const data = await response.json();\n      const points = data.result?.points || [];\n      item.json.already_processed = points.length > 0;\n    } else {\n      item.json.already_processed = false;\n    }\n  } catch (error) {\n    item.json.already_processed = false;\n  }\n}\nreturn $input.all();"
      },
      "id": "qdrant-check-exists-id",
      "name": "Check If Exists",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        420
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "filter-condition-id",
              "leftValue": "={{ $json.already_processed }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-processed-id",
      "name": "Filter Processed",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        850,
        420
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst pdfUrl = item.id.replace('/abs/', '/pdf/') + '.pdf';\nreturn {\n  json: {\n    ...item,\n    pdf_url: pdfUrl\n  }\n};"
      },
      "id": "get-pdf-url-id",
      "name": "Get PDF URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        950,
        420
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.pdf_url }}",
        "method": "GET",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "download-pdf-id",
      "name": "Download PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1100,
        420
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {}
      },
      "id": "chat-model-for-chain-id",
      "name": "OpenAI Chat Model",
      "type": "n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        1250,
        600
      ],
      "credentials": {
        "openAiApi": {
          "id": "openai-cred-id"
        }
      }
    },
    {
      "parameters": {
        "chunkSize": 4000,
        "chunkOverlap": 200
      },
      "id": "text-splitter-id",
      "name": "Recursive Character Text Splitter",
      "type": "n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        1250,
        680
      ]
    },
    {
      "parameters": {
        "dataType": "binary",
        "loader": "pdfLoader",
        "binaryDataKey": "data"
      },
      "id": "default-data-loader-id",
      "name": "Default Data Loader",
      "type": "n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1,
      "position": [
        1400,
        600
      ]
    },
    {
      "parameters": {
        "type": "map_reduce",
        "options": {}
      },
      "id": "summarization-chain-id",
      "name": "Summarization Chain",
      "type": "n8n-nodes-langchain.chainSummarization",
      "typeVersion": 2,
      "position": [
        1400,
        420
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "prompt": "You are a research assistant for an AI/ML monitoring pipeline called ResearchFlow. Your job is to help developers and researchers quickly assess new arXiv papers.\n\nGiven the full-paper summary below, respond with a JSON object and NOTHING ELSE — no markdown fences, no prose outside the object.\n\nRequired schema:\n{\n  \"what_it_does\": \"1-2 sentences on the core contribution\",\n  \"how_it_works\": \"1-2 sentences on the method or architecture\",\n  \"why_it_matters\": \"1 sentence on practical or research significance\",\n  \"relevance\": \"Low | Medium | High — for someone working on LLMs, RAG systems, or AI automation pipelines\",\n  \"tags\": [\"tag1\", \"tag2\"],\n  \"telegram_summary\": \"A single Markdown-formatted message combining all sections above, using the same emoji headings as before: 🔍 What it does, ⚙️ How it works, 📌 Why it matters, 🏷️ Relevance, 🗂️ Tags\"\n}\n\ntags must be an array of 1-3 strings chosen from: LLMs, RAG, Computer Vision, NLP, Reinforcement Learning, Robotics, AI Safety/Ethics, Multimodal, Agents, Infrastructure/MLOps — or a close match if none fit.\n\nTitle: {{ $json.title }}\nCategory: {{ $json.category }}\nFull paper summary: {{ $json.response.text }}\nPaper link: {{ $json.link }}\n\nReturn only the JSON object.",
        "options": {
          "responseFormat": "json_object"
        }
      },
      "id": "llm-summarize-id",
      "name": "OpenAI Summarize",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        1750,
        420
      ],
      "credentials": {
        "openAiApi": {
          "id": "openai-cred-id"
        }
      }
    },
    {
      "parameters": {
        "mode": "upsert",
        "collection": "arxiv_papers",
        "text": "={{ $json.parsed.telegram_summary }}",
        "metadata": {
          "metadataValues": [
            {
              "name": "title",
              "value": "={{ $json.title }}"
            },
            {
              "name": "url",
              "value": "={{ $json.id }}"
            },
            {
              "name": "tags",
              "value": "={{ $json.tags }}"
            },
            {
              "name": "relevance",
              "value": "={{ $json.relevance }}"
            },
            {
              "name": "thumbnail_url",
              "value": "={{ $json.thumbnail_url }}"
            },
            {
              "name": "category",
              "value": "={{ $json.category }}"
            },
            {
              "name": "abstract",
              "value": "={{ $('Get PDF URL').item.json.summary }}"
            },
            {
              "name": "what_it_does",
              "value": "={{ $json.parsed.what_it_does }}"
            },
            {
              "name": "how_it_works",
              "value": "={{ $json.parsed.how_it_works }}"
            },
            {
              "name": "why_it_matters",
              "value": "={{ $json.parsed.why_it_matters }}"
            }
          ]
        }
      },
      "id": "qdrant-store-id",
      "name": "Qdrant Store",
      "type": "n8n-nodes-base.qdrantVectorStore",
      "typeVersion": 1,
      "position": [
        2050,
        420
      ],
      "credentials": {
        "qdrantApi": {
          "id": "qdrant-cred-id"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.message?.content || $json.text || '';\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  // Fallback: surface the parse error clearly so it shows in execution logs\n  throw new Error(`OpenAI Summarize returned non-JSON: ${raw.slice(0, 200)}`);\n}\n\nconst tags = Array.isArray(parsed.tags) ? parsed.tags : [];\n\nreturn {\n  json: {\n    ...$json,\n    parsed,\n    tags,\n    tags_string: tags.join(', '),\n    relevance: parsed.relevance || 'Unknown',\n  }\n};\n"
      },
      "id": "extract-tags-id",
      "name": "Extract Tags",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1900,
        420
      ]
    },
    {
      "id": "dalle-thumbnail-id",
      "name": "Generate Thumbnail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        2050,
        420
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "openai-cred-id"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/images/generations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "dall-e-3"
            },
            {
              "name": "prompt",
              "value": "=Create a clean, modern, abstract scientific illustration suitable as a thumbnail for a research paper titled: \"{{ $json.title }}\". The image should visually represent the key concepts without any text. Use a professional color palette with blues and teals. Style: flat design, minimalist."
            },
            {
              "name": "n",
              "value": "1"
            },
            {
              "name": "size",
              "value": "1024x1024"
            },
            {
              "name": "quality",
              "value": "standard"
            },
            {
              "name": "response_format",
              "value": "url"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "extract-image-url-id",
      "name": "Extract Image URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        420
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const imageUrl = $json.data?.[0]?.url || '';\nreturn {\n  json: {\n    ...$json,\n    thumbnail_url: imageUrl\n  }\n};"
      }
    },
    {
      "id": "send-telegram-notification",
      "name": "Send Telegram Notification",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        2800,
        420
      ],
      "parameters": {
        "chatId": "={{ $vars.TELEGRAM_CHAT_ID }}",
        "text": "=📄 *{{ $json.title }}*\n\n{{ $json.parsed.telegram_summary }}\n\n📊 *Relevance:* {{ $json.relevance }}\n🏷️ *Tags:* {{ $json.tags_string }}\n🖼️ {{ $json.thumbnail_url }}\n🔗 {{ $json.link }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "telegram-credentials",
          "name": "Telegram account"
        }
      }
    },
    {
      "id": "send-discord-notification",
      "name": "Send Discord Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        2800,
        560
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "embeds": [
            {
              "title": "={{ $json.title }}",
              "description": "={{ $json.parsed.telegram_summary }}",
              "url": "={{ $json.link }}",
              "color": 5814783,
              "fields": [
                {
                  "name": "🏷️ Tags",
                  "value": "={{ $json.tags_string }}",
                  "inline": true
                },
                {
                  "name": "📊 Relevance",
                  "value": "={{ $json.relevance }}",
                  "inline": true
                }
              ],
              "image": {
                "url": "={{ $json.thumbnail_url }}"
              },
              "footer": {
                "text": "ResearchFlow AI • arXiv"
              }
            }
          ]
        }
      }
    }
  ],
