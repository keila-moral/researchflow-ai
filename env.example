# --- Backups (offen/docker-volume-backup) ---
# Cron schedule for backup runs (default: daily at 3am)
BACKUP_CRON=0 3 * * *
# How many days of local backups to keep before pruning
BACKUP_RETENTION_DAYS=14

# Optional: push backups offsite to an S3-compatible bucket.
# Leave blank to keep backups local-only (still safer than nothing,
# but won't survive a lost/corrupted disk).
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for non-AWS S3-compatible services (R2, MinIO, Backblaze B2, etc)
AWS_ENDPOINT=
