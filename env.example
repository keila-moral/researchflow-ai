# ─────────────────────────────────────────────
# ResearchFlow AI — environment variables
# Copy this file to .env and fill in your values
#   cp .env.example .env
# ─────────────────────────────────────────────

# ── Infrastructure ────────────────────────────
# The domain n8n will be served on (no https://)
N8N_DOMAIN=n8n.yourdomain.com

# Email used for Let's Encrypt certificate registration
ACME_EMAIL=you@yourdomain.com

# ── OpenAI ────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Telegram ──────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAF...

# Chat or channel ID to send paper notifications to
TELEGRAM_CHAT_ID=-100...

# ── Discord ───────────────────────────────────
# Webhook URL from Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Qdrant ────────────────────────────────────
# API key for Qdrant authentication (set the same value in
# the qdrant service environment in docker-compose.yml)
QDRANT_API_KEY=change-me-to-a-strong-random-string

# ── Error alert emails ────────────────────────
# Used by the Error_Handler workflow's Email Notification node
ALERT_FROM_EMAIL=n8n-alerts@yourdomain.com
ALERT_TO_EMAIL=you@yourdomain.com

# ── Backups ───────────────────────────────────
# Cron schedule for volume backups (default: daily at 3am)
BACKUP_CRON=0 3 * * *

# Number of days to keep local backup archives
BACKUP_RETENTION_DAYS=14

# ── Offsite backup (S3 / R2 / MinIO) ─────────
# Leave all four blank to keep backups local-only.

# S3 bucket name (or R2 bucket name)
AWS_S3_BUCKET_NAME=

# IAM access key ID (or R2 Access Key ID)
AWS_ACCESS_KEY_ID=

# IAM secret access key (or R2 Secret Access Key)
AWS_SECRET_ACCESS_KEY=

# Custom endpoint — required for R2/MinIO, leave blank for AWS S3
# R2 example: https://<account-id>.r2.cloudflarestorage.com
AWS_ENDPOINT=
